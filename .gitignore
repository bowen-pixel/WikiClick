# Public snapshot allowlist. Ignored research files remain on this device.
/*
!/.gitignore
!/README.md
!/Deploy.md
!/Foundation of Models.md
!/TIMELINE.md
!/AI_USAGE.md
!/code/
!/training_data/
!/figures/

# Only curated figure categories are public.
/figures/*
!/figures/README.md
!/figures/learning_curves/
!/figures/loss_functions/
!/figures/navigation/
!/figures/evolutionary/
!/figures/random_walk/
!/figures/statistics/

# Generated artifacts must not enter any public directory.
**/__pycache__/
**/*.py[cod]
**/.DS_Store
**/.env
**/.env.*
**/.pytest_cache/
**/.matplotlib/
**/.mpl-cache/
**/experiments/
**/logs/
**/test_*.py
**/*_test.py
**/*.pt
**/*.pth
**/*.safetensors
**/*.partial*
**/test_tmp/
